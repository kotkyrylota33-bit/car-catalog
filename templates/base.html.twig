 <!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Каталог автомобілів{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="{{ path('app_car_index') }}">🚗 Car Catalog</a>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-light btn-sm" href="/api/cars" target="_blank">JSON API</a>
                <a class="btn btn-primary btn-sm" href="/admin">Адмін-панель</a>
            </div>
        </div>
    </nav>

    <main class="container pb-5">
        {% block body %}{% endblock %}
    </main>
</body>
</html>