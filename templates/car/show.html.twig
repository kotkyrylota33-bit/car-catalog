 {% extends 'base.html.twig' %}

{% block title %}{{ car.brand }} {{ car.model }}{% endblock %}

{% block body %}
<a href="{{ path('app_car_index') }}" class="btn btn-outline-secondary btn-sm mb-3">← Назад до каталогу</a>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <span class="badge bg-secondary mb-2">{{ car.brand }} • {{ car.brand.country }}</span>
                <h1 class="h3 fw-bold mb-0">{{ car.brand }} {{ car.model }} ({{ car.year }})</h1>
            </div>
            <div class="fs-3 fw-bold text-success">${{ car.price|number_format(0, '.', ' ') }}</div>
        </div>

        <hr>

        <div class="row mb-4">
            <div class="col-sm-4">
                <div class="text-muted small">Рік випуску</div>
                <div class="fw-semibold">{{ car.year }}</div>
            </div>
            <div class="col-sm-4">
                <div class="text-muted small">Двигун</div>
                <div class="fw-semibold">{{ car.engine }}</div>
            </div>
            <div class="col-sm-4">
                <div class="text-muted small">Країна виробника</div>
                <div class="fw-semibold">{{ car.brand.country }}</div>
            </div>
        </div>

        <h5 class="fw-bold">Опис</h5>
        <div class="text-secondary">
            {{ car.description ? car.description|raw : 'Опис відсутній.' }}
        </div>
    </div>
</div>
{% endblock %}